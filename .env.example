# Optional. You can instead enter these in the local setup screen.
# Never commit .env or paste an API key into the presentation.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# responses or chat-completions (for an internal compatible endpoint)
LLM_PROTOCOL=responses
PORT=4318
PREVIEW_PORT=4319
# Optional absolute directory for local run data, for example C:/projects/harness-codex/.data
# HARNESS_DATA_DIR=
# Optional transport pacing for rate-limited endpoints (free tiers). Applies equally to every preset.
# Minimum milliseconds between model request starts (0 = no pacing); retries of the same request after HTTP 429 (default 3).
MODEL_MIN_INTERVAL_MS=0
MODEL_RETRY_429=3
